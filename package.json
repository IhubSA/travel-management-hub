    "typescript": "^5.4.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.12.12",
    "@types/next": "^9.0.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "prettier": "^3.3.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.11"
