# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================

# Get these from Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[project-id].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-key]

# IMPORTANT: Only use in API routes, NEVER expose to frontend
SUPABASE_SERVICE_ROLE_KEY=[service-role-key]

# ============================================================================
# EMAIL CONFIGURATION (Resend)
# ============================================================================

# Get from Resend dashboard
RESEND_API_KEY=[resend-api-key]

# Email address that all transactional emails will come from
EMAIL_FROM=noreply@angels-travel.example.com

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# The base URL of your application
# Development: http://localhost:3000
# Production: https://travel-hub.angels.org.za
APP_URL=http://localhost:3000

# Application name
NEXT_PUBLIC_APP_NAME="Travel Management Hub"

# ============================================================================
# DEVELOPMENT OPTIONS
# ============================================================================

# Enable debug mode
DEBUG=false

# Next.js environment
NODE_ENV=development
